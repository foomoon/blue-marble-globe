node_modules
.venv/
dist
test-results/
playwright-report/
.DS_Store

# NASA source downloads and intermediates (multi-GB, reproducible via npm run fetch:source)
data/

# Generated tiles (~350 MB, reproducible via npm run build:tiles).
# Their checksums are committed in provenance/build.json.
public/tiles/

# Python bytecode
__pycache__/
*.pyc

# Map server metadata, generated from the layers built on this machine (npm run server:build)
mapserver/www/
# The globe the map server serves at /globe/ (npm run server:globe)
mapserver/globe/
# The admin page (npm run server:admin) and its password file (npm run server:password)
mapserver/admin/
mapserver/auth/

# Your own settings for Vite, e.g. VITE_MAP_SERVER_URL (see .env.example)
.env.local
.env.*.local
