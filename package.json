{
  "name": "blue-marble-globe",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A clean Cesium globe on self-hosted NASA Blue Marble tiles, with full provenance.",
  "scripts": {
    "dev": "vite",
    "doctor": "python3 -I scripts/doctor.py",
    "build": "vite build",
    "preview": "vite preview",
    "server:build": "python3 -I scripts/build_server.py",
    "server:globe": "vite build --mode mapserver",
    "server:admin": "vite build --mode admin",
    "server:password": "bash scripts/admin-password.sh",
    "server:cert": "bash scripts/make-cert.sh",
    "server:up": "mkdir -p mapserver/auth mapserver/tls && python3 -I scripts/build_server.py && npm run -s server:globe && npm run -s server:admin && HOST_UID=$(id -u) HOST_GID=$(id -g) docker compose up -d --build",
    "server:down": "docker compose down",
    "bundle": "bash scripts/bundle.sh",
    "regions:export": "python3 -I scripts/region_pack.py export",
    "maps": "mkdir -p data public/tiles public/vectors provenance mapserver/www mapserver/globe mapserver/auth && HOST_UID=$(id -u) HOST_GID=$(id -g) docker compose run --rm --build builder python3 -I scripts/build_maps.py",
    "fetch:source": "python3 -I scripts/fetch_source.py",
    "fetch:terms": "python3 -I scripts/fetch_terms.py",
    "fetch:vectors": "python3 -I scripts/fetch_vectors.py",
    "build:tiles": "python3 -I scripts/build_tiles.py",
    "build:grey": "python3 -I scripts/build_grey.py",
    "build:terrain": ".venv/bin/python scripts/build_terrain.py",
    "verify:tiles": "python3 -I scripts/build_tiles.py --verify",
    "test": "playwright test",
    "test:server": "SERVER_TEST=1 playwright test tests/server.spec.js --project=server",
    "test:build": "BUILD_TEST=1 playwright test tests/build.spec.js --project=dev",
    "build:region": ".venv/bin/python scripts/build_region.py",
    "clean": "rm -rf dist data/work test-results playwright-report",
    "clean:source": "rm -rf data/source",
    "screenshots": "node scripts/screenshots.mjs"
  },
  "dependencies": {
    "cesium": "^1.136.0",
    "marked": "^16.4.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0",
    "vite": "^7.2.4",
    "vite-plugin-cesium": "^1.2.23"
  }
}
